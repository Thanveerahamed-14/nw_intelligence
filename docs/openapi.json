    "/": {
      "get": {
        "summary": "Get Dashboard",
        "operationId": "get_dashboard__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActionApprovalRequest": {
        "properties": {
          "caller_id": {
            "type": "string",
            "title": "Caller Id",
            "default": "noc_tier2_lead_sarah"
          },
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id",
            "default": "customer_a"
          },
          "comment": {
            "type": "string",
            "title": "Comment",
            "default": "Verified redundant microwave capacity and alarm correlation. Approved."
          }
        },
        "type": "object",
        "title": "ActionApprovalRequest"
      },
      "ActionRejectionRequest": {
        "properties": {
          "caller_id": {
            "type": "string",
            "title": "Caller Id",
            "default": "noc_tier2_lead_sarah"
          },
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id",
            "default": "customer_a"
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "default": "Insufficient evidence or high traffic hour."
          }
        },
        "type": "object",
        "title": "ActionRejectionRequest"
      },
      "ChangeSimulationRequest": {
        "properties": {
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id",
            "default": "customer_a"
          },
          "target_entity_id": {
            "type": "string",
            "title": "Target Entity Id",
            "default": "CSR_ALPHA_01"
          },
          "change_type": {
            "type": "string",
            "title": "Change Type",
            "default": "REROUTE_STANDBY_MICROWAVE_BACKHAUL"
          }
        },
        "type": "object",
        "title": "ChangeSimulationRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InvestigationRequest": {
        "properties": {
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id",
            "description": "Customer tenant ID",
            "default": "customer_a"
          },
          "affected_cells": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Affected Cells",
            "description": "List of cell identifiers triggering alarms",
            "default": [
              "CELL_001",
              "CELL_002",
              "CELL_003"
            ]
          },
          "incident_time": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Incident Time",
            "description": "Timestamp of incident trigger (defaults to 10:05 UTC)"
          }
        },
        "type": "object",
        "title": "InvestigationRequest"
      },
      "MCPRPCRequest": {
        "properties": {
          "jsonrpc": {
            "type": "string",
            "title": "Jsonrpc",
            "default": "2.0"
          },
          "method": {
            "type": "string",
            "title": "Method"
          },
          "params": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Params"
          },
          "id": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Id",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "method"
        ],
        "title": "MCPRPCRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}