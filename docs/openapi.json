              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/topology/neighborhood": {
      "get": {
        "summary": "Get Topology Neighborhood",
        "operationId": "get_topology_neighborhood_api_v1_topology_neighborhood_get",
        "parameters": [
          {
            "name": "entity_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Entity Id"
            }
          },
          {
            "name": "as_of",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "As Of"
            }
          },
          {
            "name": "max_hops",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 3,
              "default": 2,
              "title": "Max Hops"
            }
          },
          {
            "name": "tenant_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "customer_a",
              "title": "Tenant Id"
            }
          },
          {
            "name": "caller_role",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "alarm_management",
              "title": "Caller Role"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
