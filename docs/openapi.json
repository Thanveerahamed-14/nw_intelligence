    "/api/v1/actions/{action_id}/approve": {
      "post": {
        "summary": "Approve Action",
        "operationId": "approve_action_api_v1_actions__action_id__approve_post",
        "parameters": [
          {
            "name": "action_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Action Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
