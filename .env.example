# ==============================================================================
# TELECOM NETWORK INTELLIGENCE PLATFORM - CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI ACCESS (Google Gemini / Vertex AI)
# ------------------------------------------------------------------------------
# Obtain your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
USE_MOCK_LLM_IF_NO_KEY=true

# ------------------------------------------------------------------------------
# 2. GRAPH DATABASE (Neo4j / Bi-Temporal Engine)
# ------------------------------------------------------------------------------
# Set credentials for a live Neo4j instance, or leave blank to use the built-in
# Bi-Temporal In-Memory Graph Engine (NetworkX) with sub-2s SLA.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# ------------------------------------------------------------------------------
# 3. VECTOR DATABASE (ChromaDB / Semantic Incident Runbooks)
# ------------------------------------------------------------------------------
# Stores vector embeddings of telecom troubleshooting runbooks, historical RCAs,
# and vendor manuals (Ericsson, Nokia, Cisco).
VECTOR_DB_TYPE=chromadb
CHROMA_PERSIST_DIRECTORY=./data/vector_store

# ------------------------------------------------------------------------------
# 4. RELATIONAL / METADATA DATABASE (SQLite / PostgreSQL / Cloud SQL)
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/network_intelligence.db

# ------------------------------------------------------------------------------
# 5. GOOGLE CLOUD BIGQUERY & PUBSUB (Production Mode)
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=telecom-nw-intelligence-prod
GCP_REGION=europe-west1
BIGQUERY_DATASET_COUNTERS=telecom_counters
BIGQUERY_DATASET_KPIS=telecom_kpis
PUBSUB_TOPIC_COUNTERS=raw-telemetry-bursts

# ------------------------------------------------------------------------------
# 6. APP SERVER SETTINGS & MULTI-TENANCY
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=false
ALLOWED_TENANTS=["customer_a", "customer_b", "customer_c", "customer_d", "customer_e"]
DEFAULT_TENANT=customer_a
