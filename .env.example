# ==============================================================================
# TELECOM NETWORK INTELLIGENCE PLATFORM - CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI ACCESS (Google Gemini / Vertex AI)
# ------------------------------------------------------------------------------
# Obtain your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
# Comma-separated free-tier models tried in order when the primary model fails
# (retired, rate-limited, or temporarily unavailable). Set to empty to disable.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-flash-latest
USE_MOCK_LLM_IF_NO_KEY=false
# Per-model timeout, then fail over to the next model in the cascade.
LLM_REQUEST_TIMEOUT_SECONDS=15
# Total cascade budget (keeps the 30s agent SLA).
LLM_TOTAL_BUDGET_SECONDS=25

# ------------------------------------------------------------------------------
# 2. GRAPH DATABASE (Neo4j / Bi-Temporal Engine)
# ------------------------------------------------------------------------------
# Set credentials for a live Neo4j instance, or leave blank to use the built-in
# Bi-Temporal In-Memory Graph Engine (NetworkX) with sub-2s SLA.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# ------------------------------------------------------------------------------
# 3. VECTOR DATABASE (ChromaDB / Semantic Incident Runbooks)
# ------------------------------------------------------------------------------
# Stores vector embeddings of telecom troubleshooting runbooks, historical RCAs,
# and vendor manuals (Ericsson, Nokia, Cisco).
VECTOR_DB_TYPE=chromadb
CHROMA_PERSIST_DIRECTORY=./data/vector_store

# ------------------------------------------------------------------------------
# 4. RELATIONAL / METADATA DATABASE (SQLite / PostgreSQL / Cloud SQL)
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/network_intelligence.db

# ------------------------------------------------------------------------------
# 5. GOOGLE CLOUD BIGQUERY & PUBSUB (Production Mode)
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=telecom-nw-intelligence-prod
GCP_REGION=europe-west1
BIGQUERY_DATASET_COUNTERS=telecom_counters
BIGQUERY_DATASET_KPIS=telecom_kpis
PUBSUB_TOPIC_COUNTERS=raw-telemetry-bursts

# ------------------------------------------------------------------------------
# 6. APP SERVER SETTINGS & MULTI-TENANCY
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=false
ALLOWED_TENANTS=["customer_a", "customer_b", "customer_c", "customer_d", "customer_e"]
DEFAULT_TENANT=customer_a

# ------------------------------------------------------------------------------
# 7. API AUTHENTICATION
# ------------------------------------------------------------------------------
# API_KEYS is a JSON object mapping API key -> caller identity. When at least one
# key is present, every request MUST send a matching `X-API-Key` header.
# Example (single line):
# API_KEYS={"local-dev-key":{"caller_id":"noc_tier2_lead_sarah","role":"human_operator","tenant_ids":["customer_a","customer_b"]}}
#
# Roles: alarm_management, performance_analysis, change_planning, human_operator, system_admin
API_KEYS=

# DEMO_MODE is only honoured when API_KEYS is empty. It grants a single fixed,
# non-escalatable operator principal so the bundled dashboard runs out of the box.
# Set DEMO_MODE=false before exposing the service to any untrusted network.
DEMO_MODE=true
DEMO_CALLER_ID=demo-noc-operator
DEMO_ROLE=human_operator
DEMO_TENANTS=["customer_a", "customer_b", "customer_c", "customer_d", "customer_e"]
